<Window x:Class="Alpha.Branding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Premier | Property Branding Studio"
        Icon="Assets/logo_phoenix.png"
        Width="1220" Height="840"
        MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Poppins, sans-serif"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Control Card -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BRANDING HEADER (Matches alphapremiergroup.com header) -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Phoenix Emblem -->
                <Image Grid.Column="0"
                       Source="Assets/logo_phoenix.png"
                       Height="48"
                       Width="48"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Header Title & Company Slogan -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ALPHA PREMIER"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" | REALTY"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <Border Background="{StaticResource GoldSubtle}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="GROUP OF COMPANIES"
                                       Foreground="{StaticResource GoldLight}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Official Property Listing Watermarking &amp; Studio Suite"
                               Foreground="{StaticResource Gold}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Selection Status Chip -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceElevated}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="16,7"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectionSummary}"
                                   AutomationProperties.AutomationId="SelectionSummaryTextBlock"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CONTROL & ACTION WORKSPACE CARD -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,18"
                Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File Selection & Prefix Input -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="SELECT PHOTOS"
                                AutomationProperties.AutomationId="SelectPhotosButton"
                                Click="SelectPhotos_Click"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,18,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FILENAME PREFIX"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="PrefixTextBox"
                                         Width="230"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                                <Border Background="{StaticResource GoldSubtle}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,7"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Preview: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding PatternPreview}"
                                                   AutomationProperties.AutomationId="PatternPreviewTextBlock"
                                                   Foreground="{StaticResource GoldLight}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="APPLY BRANDING"
                                AutomationProperties.AutomationId="ApplyBrandingButton"
                                Click="Apply_Click"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,0"/>

                        <Button Content="EXPORT ZIP"
                                AutomationProperties.AutomationId="ExportZipButton"
                                Click="Export_Click"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>

                <!-- Divider & Progress / Status Row -->
                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,16,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="STATUS: " Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Status}"
                                   AutomationProperties.AutomationId="StatusTextBlock"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="12"
                                   FontWeight="Medium"/>
                    </StackPanel>

                    <ProgressBar Grid.Column="1"
                                 AutomationProperties.AutomationId="ProgressBar"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Height="8"
                                 VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- MAIN GALLERY / RESULTS AREA -->
        <Grid Grid.Row="2">
            <!-- Empty State Display -->
            <Border Visibility="{Binding Results.Count, Converter={StaticResource EmptyToVisibilityConverter}}"
                    Background="{StaticResource SurfaceDark}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Image Source="Assets/logo_phoenix.png"
                           Height="100"
                           Width="100"
                           Opacity="0.85"
                           Margin="0,0,0,22"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Alpha Premier Property Branding"
                               Foreground="{StaticResource GoldLight}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Import property photography to apply official Alpha Premier Realty watermarks and generate publication-ready high-resolution assets."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,0,0,26"/>
                    <Button Content="SELECT PHOTOS TO BEGIN"
                            AutomationProperties.AutomationId="EmptyStateSelectButton"
                            Click="SelectPhotos_Click"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Padding="28,12"/>
                </StackPanel>
            </Border>

            <!-- Results Grid Display -->
            <ScrollViewer AutomationProperties.AutomationId="ResultsScrollViewer"
                          Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Results}"
                              AutomationProperties.AutomationId="ResultsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="270"
                                    Margin="0,0,16,16"
                                    Background="{StaticResource SurfaceDark}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                                                <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Image Thumbnail -->
                                    <Border CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="{StaticResource BackgroundDark}"
                                            Height="190">
                                        <Image Source="{Binding Preview}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Filename and Details -->
                                    <Grid Margin="0,10,0,10">
                                        <TextBlock Text="{Binding FileName}"
                                                   AutomationProperties.AutomationId="ResultFileNameTextBlock"
                                                   Foreground="{StaticResource GoldLight}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}"/>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="PREVIEW"
                                                AutomationProperties.AutomationId="PreviewButton"
                                                Click="Preview_Click"
                                                IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                Style="{StaticResource SmallActionButton}"
                                                Margin="0,0,6,0"/>

                                        <Button Grid.Column="1"
                                                Content="SAVE"
                                                AutomationProperties.AutomationId="SaveButton"
                                                Click="Save_Click"
                                                IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                Style="{StaticResource SmallGoldButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>



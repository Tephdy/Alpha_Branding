<Window x:Class="Alpha.Branding.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Premier | Photo Preview"
        Icon="Assets/logo_phoenix.png"
        Width="1080" Height="820"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Poppins, sans-serif"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Image Display -->
            <RowDefinition Height="*"/>
            <!-- Navigation Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Phoenix Mark -->
                <Image Grid.Column="0"
                       Source="Assets/logo_phoenix.png"
                       Height="30" Width="30"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Current Filename -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Current.FileName}"
                           AutomationProperties.AutomationId="PreviewCurrentFileNameTextBlock"
                           Foreground="{StaticResource GoldLight}"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Position Badge -->
                <Border Grid.Column="2"
                        Background="{StaticResource GoldSubtle}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionText}"
                               AutomationProperties.AutomationId="PreviewPositionBadgeTextBlock"
                               Foreground="{StaticResource GoldLight}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- IMAGE VIEWPORT -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,14">
            <Image Source="{Binding Current.Preview}"
                   AutomationProperties.AutomationId="PreviewImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- NAVIGATION FOOTER -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ALPHA PREMIER REALTY" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>

                <!-- Centered Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="◀  PREVIOUS"
                            AutomationProperties.AutomationId="PreviewPreviousButton"
                            Click="Previous_Click"
                            Style="{StaticResource SecondaryButton}"
                            Padding="18,9"
                            Margin="0,0,12,0"/>

                    <Button Content="NEXT  ▶"
                            AutomationProperties.AutomationId="PreviewNextButton"
                            Click="Next_Click"
                            Style="{StaticResource PrimaryButton}"
                            Padding="22,9"/>
                </StackPanel>

                <!-- Keyboard Hint -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="← / → to navigate • Esc to close"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>



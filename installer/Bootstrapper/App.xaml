<Application x:Class="Alpha.Branding.Bootstrapper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Alpha Premier Official Brand Color Palette (from alphapremiergroup.com) -->
        <Color x:Key="ColorBackgroundDark">#0A0A0A</Color>
        <Color x:Key="ColorSurfaceDark">#111215</Color>
        <Color x:Key="ColorSurfaceElevated">#18191E</Color>
        <Color x:Key="ColorBorderSubtle">#423722</Color>
        <Color x:Key="ColorGold">#C5A059</Color>
        <Color x:Key="ColorGoldLight">#E2C285</Color>
        <Color x:Key="ColorGoldDark">#9E7B35</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundDark" Color="{StaticResource ColorBackgroundDark}"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="{StaticResource ColorSurfaceDark}"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource ColorSurfaceElevated}"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
        <SolidColorBrush x:Key="Gold" Color="{StaticResource ColorGold}"/>
        <SolidColorBrush x:Key="GoldLight" Color="{StaticResource ColorGoldLight}"/>
        <SolidColorBrush x:Key="GoldDark" Color="{StaticResource ColorGoldDark}"/>
        <SolidColorBrush x:Key="GoldSubtle" Color="#252015"/>
        <SolidColorBrush x:Key="Charcoal" Color="{StaticResource ColorBackgroundDark}"/>
        <SolidColorBrush x:Key="DarkSurface" Color="{StaticResource ColorSurfaceDark}"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B4BC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6C727F"/>

        <!-- Gradients -->
        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E2C285" Offset="0"/>
            <GradientStop Color="#C5A059" Offset="0.6"/>
            <GradientStop Color="#A37E36" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F0D9A8" Offset="0.5"/>
            <GradientStop Color="#E2C285" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22242B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#121316"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldGradient}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource GoldGradientHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource GoldDark}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#0D0E10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="PART_Track" Margin="1"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="1">
                                <Border x:Name="Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>


